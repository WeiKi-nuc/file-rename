{
    "name": "复杂场景 - 日期格式化插入",
    "description": "测试日期格式化插入到文件名",
    "scenario_type": "complex",
    "test_files": [
        "report.docx",
        "summary.xlsx",
        "notes.txt"
    ],
    "rule": {
        "suffix": "_dated",
        "date_format": "%Y%m%d"
    },
    "expected_results": {
        "report.docx": "report_YYYYMMDD_dated.docx",
        "summary.xlsx": "summary_YYYYMMDD_dated.xlsx",
        "notes.txt": "notes_YYYYMMDD_dated.txt"
    },
    "notes": "日期会根据文件修改时间动态生成"
}
